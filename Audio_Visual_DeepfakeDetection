t train/val/test split, augmentation, smaller regularised model,\n","# seed ensemble, validation-tuned pooling and threshold, AUC / pAUC / EER reporting.\n","\n","# %% [code]\n","import os, re, sys, glob, json, time, math, pickle, warnings\n","import numpy as np\n","import pandas as pd\n","import matplotlib\n","import matplotlib.pyplot as plt\n","\n","os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'\n","warnings.filterwarnings('ignore')\n","\n","try:\n","    import av\n","except ImportError:\n","    os.system('pip install -q av'); import av\n","import cv2\n","import librosa\n","from scipy.signal import fftconvolve, medfilt\n","from tqdm.auto import tqdm\n","from sklearn.model_selection import StratifiedGroupKFold\n","from sklearn.metrics import (accuracy_score, precision_score, recall_score, f1_score,\n","                             roc_auc_score, roc_curve, confusion_matrix, classification_report)\n","import tensorflow as tf\n","from tensorflow.keras import layers, Model, regularizers\n","\n","\n","class CFG:\n","    SEED = 42\n","    # ---- data ----\n","    SR = 16000\n","    SEG_SEC = 0.5                 # one \"sequence\" = 0.5 s\n","    MAX_LEN = 20                  # 20 x 0.5 s = 10 s (FakeAVCeleb clips are mostly 3-8 s)\n","    AUDIO_DIM = 73\n","    VIS_DIM = 62                  # 30 mean + 30 std + 2 motion\n","    # videos to sample per FakeAVCeleb category. Set the 2 single-modality fake\n","    # categories to 0 to reproduce the easier real/real vs fake/fake setting.\n","    CATEGORY_QUOTA = {\n","        'RealVideo-RealAudio': 500,\n","        'RealVideo-FakeAudio': 500,\n","        'FakeVideo-RealAudio': 500,\n","        'FakeVideo-FakeAudio': 500,\n","    }\n","    # ---- model ----\n","    GRU_UNITS = 128\n","    EMBED = 64\n","    DROPOUT = 0.3\n","    HEAD_DROPOUT = 0.4\n","    L2 = 1e-4\n","    # ---- training ----\n","    LR = 1e-3\n","    BATCH = 16\n","    EPOCHS = 80\n","    PATIENCE = 12\n","    N_MODELS = 3                  # seed ensemble\n","    LOSS = 'bce'                  # 'bce' or 'focal'\n","    NOISE_STD = 0.05              # Gaussian feature noise (augmentation)\n","    MODALITY_DROP = 0.10          # prob. of blanking one modality for a sample\n","    # ---- paths ----\n","    WORK = '/kaggle/working' if os.path.isdir('/kaggle') else './kaggle_output'\n","\n","\n","os.makedirs(CFG.WORK, exist_ok=True)\n","tf.keras.utils.set_random_seed(CFG.SEED)\n","print('TensorFlow', tf.__version__, '| GPUs:', len(tf.config.list_physical_devices('GPU')))\n","\n","# %% [markdown]\n","# ## 1. Locate the dataset\n","\n","# %% [code]\n","def find_kaggle_dataset_dir():\n","    candidates = [\n","        '/kaggle/input/fakeavceleb', '/kaggle/input/fakeavceleb/FakeAVCeleb_v1.2',\n","        '/kaggle/input/datasets/shreyaty08/fakeavceleb/FakeAVCeleb_v1.2/FakeAVCeleb_v1.2',\n","        './FakeAVCeleb_v1.2', './FakeAVCeleb_v1.2/FakeAVCeleb_v1.2',\n","    ]\n","    for c in candidates:\n","        if os.path.exists(os.path.join(c, 'meta_data.csv')):\n","            return c, os.path.join(c, 'meta_data.csv')\n","        sub = os.path.join(c, 'FakeAVCeleb_v1.2')\n","        if os.path.exists(os.path.join(sub, 'meta_data.csv')):\n","            return sub, os.path.join(sub, 'meta_data.csv')\n","    hits = glob.glob('/kaggle/input/**/meta_data.csv', recursive=True)\n","    if hits:\n","        return os.path.dirname(hits[0]), hits[0]\n","    raise FileNotFoundError('meta_data.csv not found - attach the FakeAVCeleb dataset.')\n","\n","# %% [markdown]\n","# ## 2. Decode a video (single pass) and detect the face / lip region\n","\n","# %% [code]\n","try:\n","    _FACE_CASCADE = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')\n","    if _FACE_CASCADE.empty():\n","        _FACE_CASCADE = None\n","except Exception:\n","    _FACE_CASCADE = None      # falls back to a fixed central face box\n","if _FACE_CASCADE is None:\n","    print('[!] Haar face detector unavailable - using fixed face/lip crops')\n","\n","\n","def decode_video(path, max_side=256):\n","    \"\"\"One demux pass -> (list of RGB frames resized so max side <= 256, mono 16 kHz audio, fps).\"\"\"\n","    container = av.open(path)\n","    try:\n","        vs = container.streams.video[0]\n","        fps = float(vs.average_rate) if vs.average_rate else 25.0\n","        has_audio = len(container.streams.audio) > 0\n","        streams = [vs] + ([container.streams.audio[0]] if has_audio else [])\n","        resampler = av.AudioResampler(format='fltp', layout='mono', rate=CFG.SR) if has_audio else None\n","        frames, chunks = [], []\n","        for packet in container.demux(*streams):\n","            for fr in packet.decode():\n","                if isinstance(fr, av.VideoFrame):\n","                    img = fr.to_ndarray(format='rgb24')\n","                    s = max_side / max(img.shape[:2])\n","                    if s < 1:\n","                        img = cv2.resize(img, (int(img.shape[1] * s), int(img.shape[0] * s)),\n","                                         interpolation=cv2.INTER_AREA)\n","                    frames.append(img)\n","                elif resampler is not None:\n","                    for rf in resampler.resample(fr):\n","                        chunks.append(rf.to_ndarray().reshape(-1))\n","        if resampler is not None:\n","            try:\n","                for rf in resampler.resample(None):\n","                    chunks.append(rf.to_ndarray().reshape(-1))\n","            except Exception:\n","                pass\n","    finally:\n","        container.close()\n","    audio = np.concatenate(chunks).astype(np.float32) if chunks else np.zeros(0, np.float32)\n","    return frames, audio, fps\n","\n","\n","def detect_face_box(frames):\n","    \"\"\"Median Haar-cascade face box over a few frames; falls back to a central box.\"\"\"\n","    h, w = frames[0].shape[:2]\n","    idxs = np.linspace(0, len(frames) - 1, min(5, len(frames))).astype(int)\n","    boxes = []\n","    for i in (idxs if _FACE_CASCADE is not None else []):\n","        g = cv2.cvtColor(frames[i], cv2.COLOR_RGB2GRAY)\n","        det = _FACE_CASCADE.detectMultiScale(g, 1.1, 5, minSize=(40, 40))\n","        if len(det):\n","            boxes.append(max(det, key=lambda b: b[2] * b[3]))\n","    if boxes:\n","        x, y, bw, bh = np.median(np.array(boxes), axis=0).astype(int)\n","        found = True\n","    else:\n","        x, y, bw, bh = int(.2 * w), int(.05 * h), int(.6 * w), int(.8 * h)\n","        found = False\n","    return (x, y, bw, bh), found\n","\n","\n","def crop(frame, x0, y0, x1, y1):\n","    h, w = frame.shape[:2]\n","    x0, x1 = int(np.clip(x0, 0, w - 2)), int(np.clip(x1, 1, w))\n","    y0, y1 = int(np.clip(y0, 0, h - 2)), int(np.clip(y1, 1, h))\n","    if x1 - x0 < 4 or y1 - y0 < 4:\n","        return frame\n","    return frame[y0:y1, x0:x1]\n","\n","\n","def face_roi(frame, box):\n","    x, y, bw, bh = box\n","    return crop(frame, x - .1 * bw, y - .1 * bh, x + 1.1 * bw, y + 1.1 * bh)\n","\n","\n","def lip_roi(frame, box):\n","    x, y, bw, bh = box\n","    return crop(frame, x + .20 * bw, y + .62 * bh, x + .80 * bw, y + .97 * bh)\n","\n","# %% [markdown]\n","# ## 3. Segment-level features (audio 73-D, face 62-D, lip 62-D)\n","\n","# %% [code]\n","def safe_delta(m, order=1):\n","    \"\"\"librosa delta that never fails on very short inputs (fixes the 'width=9' crash).\"\"\"\n","    n = m.shape[1]\n","    w = min(9, n if n % 2 == 1 else n - 1)\n","    if w < 3:\n","        return np.zeros_like(m)\n","    return librosa.feature.delta(m, order=order, width=w, mode='nearest')\n","\n","\n","def audio_features_73(y, sr=CFG.SR):\n","    y = np.nan_to_num(np.asarray(y, np.float32))\n","    if len(y) < 512:\n","        return np.zeros(CFG.AUDIO_DIM, np.float32)\n","    n_fft, hop = 512, 256\n","    mfcc = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=13, n_fft=n_fft, hop_length=hop)\n","    f_mfcc = np.concatenate([mfcc.mean(1), safe_delta(mfcc, 1).mean(1), safe_delta(mfcc, 2).mean(1)])\n","    kw = dict(y=y, n_fft=n_fft, hop_length=hop)\n","    cent = librosa.feature.spectral_centroid(sr=sr, **kw).mean(1)\n","    bw = librosa.feature.spectral_bandwidth(sr=sr, **kw).mean(1)\n","    roll = librosa.feature.spectral_rolloff(sr=sr, **kw).mean(1)\n","    flat = librosa.feature.spectral_flatness(**kw).mean(1)\n","    con = librosa.feature.spectral_contrast(sr=sr, n_bands=6, fmin=200.0, **kw).mean(1)   # 7\n","    chroma = librosa.feature.chroma_stft(sr=sr, **kw).mean(1)                                # 12\n","    rms = librosa.feature.rms(y=y, frame_length=n_fft, hop_length=hop).mean(1)\n","    zcr = librosa.feature.zero_crossing_rate(y, frame_length=n_fft, hop_length=hop).mean(1)\n","    ac = fftconvolve(y, y[::-1], mode='full')[len(y) - 1:]\n","    lo, hi = max(1, int(sr / 500)), min(len(ac) - 1, int(sr / 50))\n","    pitch = sr / (lo + np.argmax(ac[lo:hi])) if ac[0] > 0 and hi > lo else 0.0\n","    S = np.abs(librosa.stft(y, n_fft=n_fft, hop_length=hop))\n","    stats = np.log1p(np.array([S.mean(), S.std(), S.max(), S.min(), np.median(S), S.var(),\n","                               (S ** 2).mean(), (S ** 2).std()], np.float32))\n","    feat = np.concatenate([f_mfcc, cent, bw, roll, flat, con, chroma, rms, zcr,\n","                           [pitch], stats]).astype(np.float32)\n","    assert feat.shape[0] == CFG.AUDIO_DIM, feat.shape\n","    return np.nan_to_num(feat)\n","\n","\n","def frame_descriptor(roi):\n","    \"\"\"30-D appearance descriptor + 32x32 grey patch (for motion).\"\"\"\n","    r = cv2.resize(roi, (64, 64))\n","    g = cv2.cvtColor(r, cv2.COLOR_RGB2GRAY)\n","    cm = r.reshape(-1, 3).mean(0) / 255.0\n","    cs = r.reshape(-1, 3).std(0) / 255.0\n","    gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, ksize=3)\n","    gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, ksize=3)\n","    mag, ang = cv2.cartToPolar(gx, gy)\n","    hist, _ = np.histogram(ang, bins=8, range=(0, 2 * np.pi), weights=mag)\n","    hist = hist / (np.linalg.norm(hist) + 1e-6)\n","    blocks = g.reshape(4, 16, 4, 16).mean((1, 3)).reshape(-1) / 255.0\n","    small = cv2.resize(g, (32, 32)).astype(np.float32) / 255.0\n","    return np.concatenate([cm, cs, hist, blocks]).astype(np.float32), small\n","\n","\n","def visual_features_62(chunk, box, roi_fn):\n","    \"\"\"mean(30) + temporal std(30) + motion(2) over up to 6 frames of the segment.\"\"\"\n","    if len(chunk) == 0:\n","        return np.zeros(CFG.VIS_DIM, np.float32)\n","    idx = np.linspace(0, len(chunk) - 1, min(6, len(chunk))).astype(int)\n","    descs, greys = [], []\n","    for i in idx:\n","        d, g = frame_descriptor(roi_fn(chunk[i], box))\n","        descs.append(d); greys.append(g)\n","    D = np.stack(descs)\n","    diffs = [np.abs(greys[k + 1] - greys[k]).mean() for k in range(len(greys) - 1)]\n","    motion = [np.mean(diffs), np.max(diffs)] if diffs else [0.0, 0.0]\n","    return np.concatenate([D.mean(0), D.std(0), motion]).astype(np.float32)\n","\n","\n","def features_from_streams(frames, audio, fps):\n","    n_frames = len(frames)\n","    if n_frames == 0:\n","        raise ValueError('no video frames')\n","    duration = n_frames / fps\n","    n_seg = int(math.floor(duration / CFG.SEG_SEC))\n","    if n_seg == 0 or duration - n_seg * CFG.SEG_SEC >= 0.25:\n","        n_seg += 1\n","    n_seg = max(1, min(n_seg, CFG.MAX_LEN))\n","    box, found = detect_face_box(frames)\n","    A = np.zeros((n_seg, CFG.AUDIO_DIM), np.float32)\n","    F = np.zeros((n_seg, CFG.VIS_DIM), np.float32)\n","    L = np.zeros((n_seg, CFG.VIS_DIM), np.float32)\n","    for s in range(n_seg):\n","        t0, t1 = s * CFG.SEG_SEC, min(duration, (s + 1) * CFG.SEG_SEC)\n","        A[s] = audio_features_73(audio[int(t0 * CFG.SR):int(t1 * CFG.SR)])\n","        f0 = min(n_frames - 1, int(t0 * fps))\n","        f1 = max(f0 + 1, min(n_frames, int(t1 * fps)))\n","        chunk = frames[f0:f1]\n","        F[s] = visual_features_62(chunk, box, face_roi)\n","        L[s] = visual_features_62(chunk, box, lip_roi)\n","    return {'audio': A, 'face': F, 'lip': L, 'n_seg': n_seg, 'duration': duration, 'face_found': found}\n","\n","\n","def extract_video_features(path):\n","    frames, audio, fps = decode_video(path)\n","    return features_from_streams(frames, audio, fps)\n","\n","# %% [markdown]\n","# ## 4. Build (or load) the feature cache\n","\n","# %% [code]\n","def speaker_id(video_path):\n","    m = re.search(r'(id\\d{5})', os.path.dirname(video_path))\n","    return m.group(1) if m else os.path.basename(os.path.dirname(video_path))\n","\n","\n","def collect_video_list(dataset_dir, meta_path):\n","    df = pd.read_csv(meta_path)\n","    tasks = []\n","    for cat, quota in CFG.CATEGORY_QUOTA.items():\n","        if quota <= 0:\n","            continue\n","        sub = df[df['type'] == cat]\n","        sub = sub.sample(n=min(quota, len(sub)), random_state=CFG.SEED)\n","        n_ok = 0\n","        for _, row in sub.iterrows():\n","            folder = str(row['Unnamed: 9']).replace('FakeAVCeleb/', '')\n","            p = os.path.join(dataset_dir, folder, str(row['path']))\n","            if os.path.exists(p):\n","                tasks.append((p, 0 if cat == 'RealVideo-RealAudio' else 1, cat))\n","                n_ok += 1\n","        print(f'  {cat:22s}: {n_ok} files queued')\n","    return tasks\n","\n","\n","def load_or_extract(tasks, cache_file):\n","    cache = pickle.load(open(cache_file, 'rb')) if os.path.exists(cache_file) else {}\n","    failed, t0 = [], time.time()\n","    for p, label, cat in tqdm(tasks, desc='Extracting'):\n","        if p in cache:\n","            continue\n","        try:\n","            r = extract_video_features(p)\n","            r.update(path=p, label=label, category=cat, group=speaker_id(p))\n","            cache[p] = r\n","        except Exception as e:\n","            failed.append((p, repr(e)[:120]))\n","    pickle.dump(cache, open(cache_file, 'wb'), protocol=pickle.HIGHEST_PROTOCOL)\n","    recs = [cache[p] for p, _, _ in tasks if p in cache]\n","    print(f'[+] {len(recs)}/{len(tasks)} videos usable | {len(failed)} failed | {time.time() - t0:.0f}s')\n","    for p, e in failed[:5]:\n","        print('   failed:', os.path.basename(p), e)\n","    return recs\n","\n","# %% [markdown]\n","# ## 5. Subject-disjoint split, padding, standardisation\n","\n","# %% [code]\n","def group_split(cats, groups, seed=CFG.SEED):\n","    \"\"\"~71/14/14 split with NO speaker shared between train, val and test.\"\"\"\n","    idx = np.arange(len(cats))\n","    codes = pd.factorize(cats)[0]\n","    trv, te = next(StratifiedGroupKFold(7, shuffle=True, random_state=seed).split(idx, codes, groups))\n","    tr_i, va_i = next(StratifiedGroupKFold(6, shuffle=True, random_state=seed)\n","                      .split(trv, codes[trv], groups[trv]))\n","    tr, va = trv[tr_i], trv[va_i]\n","    assert not (set(groups[tr]) & set(groups[va]) or set(groups[tr]) & set(groups[te])\n","                or set(groups[va]) & set(groups[te])), 'speaker leakage!'\n","    return tr, va, te\n","\n","\n","def pad_records(recs, T=CFG.MAX_LEN):\n","    N = len(recs)\n","    X = {'lip': np.zeros((N, T, CFG.VIS_DIM), np.float32),\n","         'audio': np.zeros((N, T, CFG.AUDIO_DIM), np.float32),\n","         'face': np.zeros((N, T, CFG.VIS_DIM), np.float32),\n","         'mask': np.zeros((N, T), np.float32)}\n","    y = np.zeros((N, T, 1), np.float32)\n","    lengths = np.zeros(N, int)\n","    for i, r in enumerate(recs):\n","        n = min(r['n_seg'], T)\n","        X['lip'][i, :n] = r['lip'][:n]; X['audio'][i, :n] = r['audio'][:n]\n","        X['face'][i, :n] = r['face'][:n]; X['mask'][i, :n] = 1.0\n","        y[i, :n, 0] = r['label']; lengths[i] = n\n","    return X, y, lengths\n","\n","\n","def fit_scaler(X):\n","    m = X['mask'].astype(bool)\n","    return {k: (X[k][m].mean(0), X[k][m].std(0) + 1e-6) for k in ('lip', 'audio', 'face')}\n","\n","\n","def apply_scaler(X, sc):\n","    out = {'mask': X['mask']}\n","    for k in ('lip', 'audio', 'face'):\n","        mu, sd = sc[k]\n","        out[k] = (np.clip((X[k] - mu) / sd, -5, 5) * X['mask'][..., None]).astype(np.float32)\n","    return out\n","\n","# %% [markdown]\n","# ## 6. Model: Bi-GRU encoders + **masked** pairwise cross-attention\n","\n","# %% [code]\n","@tf.keras.utils.register_keras_serializable(package='mmmsba')\n","class StripMask(layers.Layer):\n","    \"\"\"Passes tensors through but drops the Keras mask (we handle masking explicitly).\"\"\"\n","    def __init__(self, **kw):\n","        super().__init__(**kw); self.supports_masking = True\n","    def call(self, x): return x\n","    def compute_mask(self, inputs, mask=None): return None\n","\n","\n","@tf.keras.utils.register_keras_serializable(package='mmmsba')\n","class MaskedCrossAttention(layers.Layer):\n","    \"\"\"Bi-modal attention (paper Eq. 2-7) over sequences, ignoring padded steps.\"\"\"\n","    def __init__(self, **kw):\n","        super().__init__(**kw); self.supports_masking = True\n","    def call(self, inputs):\n","        x, y, mask = inputs\n","        x, y = tf.cast(x, tf.float32), tf.cast(y, tf.float32)\n","        scale = tf.math.rsqrt(tf.cast(tf.shape(x)[-1], tf.float32))\n","        key_bias = (1.0 - tf.cast(mask, tf.float32))[:, None, :] * -1e4        # (B,1,T)\n","        s1 = tf.matmul(x, y, transpose_b=True) * scale + key_bias                # M1 = X.Y^T\n","        s2 = tf.matmul(y, x, transpose_b=True) * scale + key_bias                # M2 = Y.X^T\n","        o1 = tf.matmul(tf.nn.softmax(s1, -1), y)                                 # O1 = K1.Y\n","        o2 = tf.matmul(tf.nn.softmax(s2, -1), x)                                 # O2 = K2.X\n","        return tf.concat([o1 * x, o2 * y], -1)                                   # gating + concat\n","    def compute_mask(self, inputs, mask=None): return None\n","\n","\n","def build_model(seed=0):\n","    T = CFG.MAX_LEN\n","    in_l = layers.Input((T, CFG.VIS_DIM), name='lip')\n","    in_a = layers.Input((T, CFG.AUDIO_DIM), name='audio')\n","    in_f = layers.Input((T, CFG.VIS_DIM), name='face')\n","    in_m = layers.Input((T,), name='mask')\n","\n","    bool_mask = layers.Lambda(lambda m: tf.cast(m, tf.bool), name='bool_mask')(in_m)\n","\n","    def encoder(x, name):\n","        x = layers.Bidirectional(layers.GRU(CFG.GRU_UNITS, return_sequences=True, dropout=CFG.DROPOUT,\n","                                            kernel_regularizer=regularizers.l2(CFG.L2)),\n","                                 name=f'bigru_{name}')(x, mask=bool_mask)      # padded steps are skipped\n","        x = StripMask()(x)\n","        x = layers.LayerNormalization()(x)\n","        x = layers.Dense(CFG.EMBED, activation='relu', kernel_regularizer=regularizers.l2(CFG.L2),\n","                         name=f'embed_{name}')(x)\n","        return layers.Dropout(CFG.DROPOUT)(x)\n","\n","    L, A, F = encoder(in_l, 'lip'), encoder(in_a, 'audio'), encoder(in_f, 'face')\n","    att_fl = MaskedCrossAttention(name='att_face_lip')([F, L, in_m])\n","    att_af = MaskedCrossAttention(name='att_audio_face')([A, F, in_m])\n","    att_la = MaskedCrossAttention(name='att_lip_audio')([L, A, in_m])\n","    W = layers.Concatenate()([att_fl, att_af, att_la, F, A, L])           # residual-style skip (paper Eq. 6)\n","    W = layers.Dropout(CFG.HEAD_DROPOUT)(W)\n","    W = layers.Dense(64, activation='relu', kernel_regularizer=regularizers.l2(CFG.L2))(W)\n","    out = layers.Dense(1, activation='sigmoid', dtype='float32', name='step_prob')(W)\n","    return Model([in_l, in_a, in_f, in_m], out, name='MMMS_BA_v2')\n","\n","\n","def get_loss():\n","    if CFG.LOSS == 'focal':\n","        return tf.keras.losses.BinaryFocalCrossentropy(gamma=2.0)\n","    return tf.keras.losses.BinaryCrossentropy()\n","\n","# %% [markdown]\n","# ## 7. Data pipeline with augmentation + masked training\n","\n","# %% [code]\n","def make_ds(X, y, w, training, seed=0):\n","    ds = tf.data.Dataset.from_tensor_slices((X, y, w))\n","    if training:\n","        ds = ds.shuffle(len(y), seed=seed, reshuffle_each_iteration=True)\n","    ds = ds.batch(CFG.BATCH)\n","    if training:\n","        def augment(x, yy, ww):\n","            m = x['mask'][..., None]\n","            out = {'mask': x['mask']}\n","            for k in ('lip', 'audio', 'face'):\n","                v = x[k] + tf.random.normal(tf.shape(x[k]), stddev=CFG.NOISE_STD)\n","                keep = tf.cast(tf.random.uniform([tf.shape(v)[0], 1, 1]) > CFG.MODALITY_DROP, v.dtype)\n","                v = v * keep + 1e-3 * tf.random.normal(tf.shape(v)) * (1.0 - keep)   # blank a modality\n","                out[k] = v * m                                                         # padding stays 0\n","            return out, yy, ww\n","        ds = ds.map(augment, num_parallel_calls=tf.data.AUTOTUNE)\n","    return ds.prefetch(1)\n","\n","\n","def train_one(Xtr, ytr, wtr, Xva, yva, wva, seed, tag):\n","    tf.keras.utils.set_random_seed(seed)\n","    model = build_model()\n","    model.compile(optimizer=tf.keras.optimizers.Adam(CFG.LR, clipnorm=1.0), loss=get_loss(),\n","                  weighted_metrics=[tf.keras.metrics.BinaryAccuracy(name='acc'),\n","                                    tf.keras.metrics.AUC(name='auc')])\n","    wpath = os.path.join(CFG.WORK, f'mmmsba_v2_{tag}.weights.h5')\n","    cbs = [tf.keras.callbacks.ModelCheckpoint(wpath, monitor='val_loss', save_best_only=True,\n","                                              save_weights_only=True),\n","           tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=CFG.PATIENCE,\n","                                            restore_best_weights=True),\n","           tf.keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, min_lr=1e-5)]\n","    hist = model.fit(make_ds(Xtr, ytr, wtr, True, seed), validation_data=make_ds(Xva, yva, wva, False),\n","                     epochs=CFG.EPOCHS, callbacks=cbs, verbose=2)\n","    model.load_weights(wpath)\n","    return model, hist.history, wpath\n","\n","# %% [markdown]\n","# ## 8. Video-level scoring, threshold tuning and metrics\n","\n","# %% [code]\n","def pool_scores(step_probs, lengths, pooling):\n","    out = []\n","    for p, l in zip(step_probs, lengths):\n","        p = p[:l]\n","        if pooling == 'mean':\n","            out.append(p.mean())\n","        elif pooling == 'max':\n","            out.append(p.max())\n","        else:  # 'topk' = mean of the most suspicious 40% of segments\n","            k = max(1, int(math.ceil(0.4 * l)))\n","            out.append(np.sort(p)[-k:].mean())\n","    return np.array(out)\n","\n","\n","def eer_from_roc(fpr, tpr):\n","    fnr = 1 - tpr\n","    i = np.nanargmin(np.abs(fpr - fnr))\n","    return float((fpr[i] + fnr[i]) / 2)\n","\n","\n","def choose_pooling_and_threshold(step_val, len_val, y_val):\n","    best = None\n","    for pooling in ('mean', 'topk', 'max'):\n","        s = pool_scores(step_val, len_val, pooling)\n","        auc = roc_auc_score(y_val, s)\n","        fpr, tpr, thr = roc_curve(y_val, s)\n","        j = tpr - fpr\n","        ok = np.isfinite(thr) & (j >= j.max() - 1e-9)\n","        t = float(np.median(thr[ok])) if ok.any() else 0.5       # middle of the best-threshold range\n","        t = min(max(t, 0.0), 1.0)\n","        if best is None or auc > best['auc'] + 1e-9:\n","            best = {'pooling': pooling, 'threshold': t, 'auc': float(auc)}\n","    return best\n","\n","\n","def full_metrics(y, s, thr):\n","    pred = (s >= thr).astype(int)\n","    fpr, tpr, _ = roc_curve(y, s)\n","    return {\n","        'accuracy': accuracy_score(y, pred), 'precision': precision_score(y, pred, zero_division=0),\n","        'recall_TPR': recall_score(y, pred, zero_division=0), 'f1': f1_score(y, pred, zero_division=0),\n","        'FPR': float(((pred == 1) & (y == 0)).sum() / max(1, (y == 0).sum())),\n","        'AUC': roc_auc_score(y, s), 'pAUC@10%FPR': roc_auc_score(y, s, max_fpr=0.1),\n","        'EER': eer_from_roc(fpr, tpr), 'confusion': confusion_matrix(y, pred, labels=[0, 1]), 'pred': pred,\n","    }\n","\n","# %% [markdown]\n","# ## 9. Run the whole experiment\n","\n","# %% [code]\n","def run_experiment():\n","    dataset_dir, meta_path = find_kaggle_dataset_dir()\n","    print('[+] dataset:', dataset_dir)\n","    tasks = collect_video_list(dataset_dir, meta_path)\n","    cache_file = os.path.join(CFG.WORK, f'features_v2_L{CFG.MAX_LEN}.pkl')\n","    recs = load_or_extract(tasks, cache_file)\n","\n","    cats = np.array([r['category'] for r in recs]); labels = np.array([r['label'] for r in recs])\n","    groups = np.array([r['group'] for r in recs])\n","    tr, va, te = group_split(cats, groups)\n","    print(f'[+] split (videos / speakers): train {len(tr)}/{len(set(groups[tr]))} | '\n","          f'val {len(va)}/{len(set(groups[va]))} | test {len(te)}/{len(set(groups[te]))}')\n","    print('    test class balance  real/fake =', (labels[te] == 0).sum(), '/', (labels[te] == 1).sum())\n","    return recs, tr, va, te\n","\n","\n","def train_and_evaluate(recs, tr, va, te):\n","    Xall, yall, lens = pad_records(recs)\n","    labels = np.array([r['label'] for r in recs]); cats = np.array([r['category'] for r in recs])\n","    scaler = fit_scaler({k: v[tr] for k, v in Xall.items()})\n","    Xs = apply_scaler(Xall, scaler)\n","    take = lambda idx: ({k: v[idx] for k, v in Xs.items()}, yall[idx])\n","    (Xtr, ytr), (Xva, yva), (Xte, yte) = take(tr), take(va), take(te)\n","\n","    # class-balanced, padding-masked sample weights\n","    cw = {c: len(tr) / (2.0 * max(1, (labels[tr] == c).sum())) for c in (0, 1)}\n","    # x (T / mean valid length) so padded slots do not dilute the loss\n","    norm = CFG.MAX_LEN / float(lens[tr].mean())\n","    wfun = lambda idx: Xs['mask'][idx] * np.vectorize(cw.get)(labels[idx])[:, None] * norm\n","    wtr, wva = wfun(tr), wfun(va)\n","\n","    models, hists, wpaths = [], [], []\n","    for i in range(CFG.N_MODELS):\n","        print(f'\\n=== training model {i + 1}/{CFG.N_MODELS} (seed {CFG.SEED + i}) ===')\n","        m, h, wp = train_one(Xtr, ytr, wtr, Xva, yva, wva, CFG.SEED + i, f'seed{i}')\n","        models.append(m); hists.append(h); wpaths.append(wp)\n","\n","    def ens_predict(X):\n","        return np.mean([m.predict(X, batch_size=32, verbose=0)[..., 0] for m in models], axis=0)\n","\n","    sv, st = ens_predict(Xva), ens_predict(Xte)\n","    sel = choose_pooling_and_threshold(sv, lens[va], labels[va])\n","    print('\\n[+] chosen on VALIDATION ->', sel)\n","    s_te = pool_scores(st, lens[te], sel['pooling'])\n","    met = full_metrics(labels[te], s_te, sel['threshold'])\n","\n","    # step-level accuracy on valid steps only (no padding)\n","    step_true = np.concatenate([yte[i, :lens[te][i], 0] for i in range(len(te))])\n","    step_pred = np.concatenate([(st[i, :lens[te][i]] >= sel['threshold']).astype(float) for i in range(len(te))])\n","    met['step_accuracy'] = float((step_true == step_pred).mean())\n","\n","    print('\\n' + '=' * 62 + '\\n  FINAL TEST RESULTS (unseen speakers)\\n' + '=' * 62)\n","    for k in ('accuracy', 'precision', 'recall_TPR', 'FPR', 'f1', 'AUC', 'pAUC@10%FPR', 'EER', 'step_accuracy'):\n","        print(f'  {k:14s}: {met[k]:.4f}')\n","    print('\\nConfusion matrix (rows = actual real/fake):\\n', met['confusion'])\n","    print('\\n', classification_report(labels[te], met['pred'], target_names=['Real', 'Deepfake'], zero_division=0))\n","    print('Per-category accuracy on test:')\n","    for c in sorted(set(cats[te])):\n","        mk = cats[te] == c\n","        print(f'  {c:22s}: {(met[\"pred\"][mk] == labels[te][mk]).mean():.3f}  (n={mk.sum()})')\n","\n","    # persist everything needed for inference\n","    np.savez(os.path.join(CFG.WORK, 'scaler_v2.npz'),\n","             **{f'{k}_{j}': scaler[k][j] for k in scaler for j in (0, 1)})\n","    json.dump({'pooling': sel['pooling'], 'threshold': sel['threshold'], 'n_models': CFG.N_MODELS,\n","               'max_len': CFG.MAX_LEN}, open(os.path.join(CFG.WORK, 'meta_v2.json'), 'w'))\n","    return models, hists, sel, met, (labels[te], s_te, sv, labels[va])\n","\n","# %% [code]\n","recs, tr, va, te = run_experiment()\n","models, hists, sel, met, (y_te, s_te, s_va, y_va) = train_and_evaluate(recs, tr, va, te)\n","\n","# %% [markdown]\n","# ## 10. Plots\n","\n","# %% [code]\n","fig, ax = plt.subplots(1, 3, figsize=(16, 4.2))\n","for i, h in enumerate(hists):\n","    ax[0].plot(h['loss'], color='tab:blue', alpha=.5, label='train' if i == 0 else None)\n","    ax[0].plot(h['val_loss'], color='tab:orange', alpha=.8, label='validation' if i == 0 else None)\n","ax[0].set_title('Masked loss (each seed)'); ax[0].set_xlabel('epoch'); ax[0].legend(); ax[0].grid(ls=':')\n","fpr, tpr, _ = roc_curve(y_te, s_te)\n","ax[1].plot(fpr, tpr, lw=2, label=f\"AUC={met['AUC']:.3f}\"); ax[1].plot([0, 1], [0, 1], 'k:')\n","ax[1].set_title('ROC (test)'); ax[1].set_xlabel('FPR'); ax[1].set_ylabel('TPR'); ax[1].legend(); ax[1].grid(ls=':')\n","cm = met['confusion']; ax[2].imshow(cm, cmap='Blues')\n","for i in range(2):\n","    for j in range(2):\n","        ax[2].text(j, i, cm[i, j], ha='center', va='center', fontsize=16,\n","                   color='white' if cm[i, j] > cm.max() / 2 else 'black')\n","ax[2].set_xticks([0, 1]); ax[2].set_xticklabels(['Real', 'Fake']); ax[2].set_yticks([0, 1])\n","ax[2].set_yticklabels(['Real', 'Fake']); ax[2].set_xlabel('Predicted'); ax[2].set_ylabel('Actual')\n","ax[2].set_title('Confusion matrix (test)')\n","plt.tight_layout(); plt.savefig(os.path.join(CFG.WORK, 'results_v2.png'), dpi=130); plt.show()\n","\n","# %% [markdown]\n","# ## 11. Inference on any video\n","def load_inference_bundle():\n","    meta = json.load(open(os.path.join(CFG.WORK, 'meta_v2.json')))\n","    z = np.load(os.path.join(CFG.WORK, 'scaler_v2.npz'))\n","    scaler = {k: (z[f'{k}_0'], z[f'{k}_1']) for k in ('lip', 'audio', 'face')}\n","    ms = []\n","    for i in range(meta['n_models']):\n","        m = build_model()\n","        m.load_weights(os.path.join(CFG.WORK, f'mmmsba_v2_seed{i}.weights.h5'))\n","        ms.append(m)\n","    return meta, scaler, ms\n","def predict_video(video_path, bundle=None, smooth=True):\n","    meta, scaler, ms = bundle or load_inference_bundle()\n","    r = extract_video_features(video_path)\n","    r.update(label=0)\n","    X, _, lens = pad_records([r])\n","    X = apply_scaler(X, scaler)\n","    probs = np.mean([m.predict(X, verbose=0)[0, :, 0] for m in ms], axis=0)[:lens[0]]\n","    seg = medfilt(probs, 3) if (smooth and len(probs) >= 3) else probs\n","    score = float(pool_scores(seg[None, :], [len(seg)], meta['pooling'])[0])\n","    is_fake = score >= meta['threshold']\n","    timeline = ''.join('#' if p >= max(meta['threshold'], .5) else ('?' if p >= .35 else '=') for p in seg)\n","    print('=' * 60)\n","    print(f' Video     : {os.path.basename(video_path)}')\n","    print(f' Verdict   : {\"DEEPFAKE / MANIPULATED\" if is_fake else \"AUTHENTIC / REAL\"}')\n","    print(f' Score     : {score:.3f}  (threshold {meta[\"threshold\"]:.3f}, pooling={meta[\"pooling\"]})')\n","    print(f' Segments  : {len(seg)}   Timeline: [{timeline}]   (# suspicious, ? uncertain, = real-like)')\n","    print(f' Face found: {r[\"face_found\"]}')\n","    print('=' * 60)\n","    return {'is_deepfake': bool(is_fake), 'score': score, 'segment_scores': seg.tolist()}\n","\n","\n","\n","# %% [code]\n","# Example:\n","# bundle = load_inference_bundle()\n","# predict_video('/kaggle/input/.../00118_id00087_wavtolip.mp4', bundle)\n"]},{"cell_type":"code","execution_count":2,"id":"96bd17e2","metadata":{"execution":{"iopub.execute_input":"2026-11-23T07:25:32.458159Z","iopub.status.busy":"2026-11-23T07:25:32.457916Z","iopub.status.idle":"2026-11-23T07:25:36.563963Z","shell.execute_reply":"2026-11-23T07:25:36.563109Z"},"papermill":{"duration":4.114288,"end_time":"2026-11-23T07:25:36.565636+00:00","exception":false,"start_time":"2026-11-23T07:25:32.